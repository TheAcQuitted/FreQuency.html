<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="369 Vibration Lab — Multi-frequency sound healing with zero-hardware mic + accelerometer physical resonance reader.">
    <title>369 Vibration Lab • FreQuency</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#00ffcc">

    <style>
        :root { --bg: #050505; --accent: #00ffcc; --text: #f0f0f0; --panel: #111; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }
        h1 { text-align: center; color: var(--accent); text-shadow: 0 0 20px var(--accent); font-size: 2.4em; }
        .section { background: var(--panel); border: 2px solid #0a0; border-radius: 18px; padding: 20px; margin-bottom: 20px; }
        .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        button {
            background: #000; color: var(--accent); border: 2px solid var(--accent);
            padding: 12px 20px; border-radius: 12px; cursor: pointer; font-weight: bold;
        }
        button.active { background: #0f0; color: #000; }
        .freq-display, .sensor-display { font-size: 2.8em; font-weight: bold; text-align: center; margin: 15px 0; min-height: 70px; }
        canvas { width: 100%; background: #000; border-radius: 12px; }
        .sensor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    </style>
</head>
<body>
<div class="container" style="max-width:1200px; margin:0 auto;">
    <h1>369 ADVANCED VIBRATION LAB</h1>
    <p style="text-align:center; color:#aaa;">Tesla • Solfeggio • Live Resonance Reader (Mic + Accelerometer)</p>

    <!-- MASTER CONTROLS -->
    <div class="section">
        <div class="freq-display" id="masterFreq">174 Hz</div>
        <input type="range" id="masterSlider" min="20" max="2000" value="174" step="1">
    </div>

    <!-- MULTI-OSCILLATORS -->
    <div class="section">
        <h2>Multi-Frequency Engine</h2>
        <div id="oscillators" class="controls"></div>
        <button onclick="addOscillator()">+ Add Oscillator</button>
        <button onclick="clearAllOscillators()" style="margin-left:10px;">Clear All</button>
    </div>

    <!-- PHYSICAL READERS - BOTH OPTIONS -->
    <div class="section">
        <h2>📡 Zero-Hardware Physical Frequency Readers</h2>
        <div class="sensor-grid">
            <!-- Microphone -->
            <div>
                <button onclick="toggleMic()" id="micBtn" style="width:100%;">🎤 MICROPHONE<br><small>Tap near object</small></button>
                <div class="sensor-display" id="micFreq" style="color:#ff0;">— Hz</div>
                <canvas id="micCanvas" width="600" height="100"></canvas>
            </div>
            
            <!-- Accelerometer -->
            <div>
                <button onclick="toggleAccel()" id="accelBtn" style="width:100%;">📱 ACCELEROMETER<br><small>Phone on rock</small></button>
                <div class="sensor-display" id="accelFreq" style="color:#0ff;">— Hz</div>
                <canvas id="accelCanvas" width="600" height="100"></canvas>
            </div>
        </div>

        <!-- Combined Best Guess -->
        <div style="text-align:center; margin-top:20px;">
            <button onclick="toggleCombined()" id="combinedBtn" style="width:80%; font-size:1.1em;">🔄 BEST GUESS (Both Sensors)</button>
            <div class="sensor-display" id="combinedFreq" style="color:#f0f; font-size:3em;">— Hz</div>
        </div>
    </div>

    <!-- PRESETS & VISUALIZER (kept for completeness) -->
    <div class="section">
        <h2>369 & Sacred Presets</h2>
        <div class="preset-grid" id="presets" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px;"></div>
    </div>

    <div class="section">
        <h2>Live Cymatics Visualizer</h2>
        <canvas id="visualizer" width="800" height="260"></canvas>
    </div>

    <div style="text-align:center; margin:30px 0;">
        <button onclick="toggleMaster()" id="powerBtn" style="font-size:1.5em; padding:20px 50px;">START VIBRATION LAB</button>
    </div>
</div>

<script>
// ====================== AUDIO & OSCILLATORS (core from before) ======================
let audioCtx, masterGain, oscillators = [], isRunning = false;

function initAudio() {
    if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = 0.6;
        masterGain.connect(audioCtx.destination);
    }
}

function createOscillator(freq, type = 'sine') {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.value = 0.3;
    osc.connect(gain).connect(masterGain);
    return {osc, gain, freq, type};
}

